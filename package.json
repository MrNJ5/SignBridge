{
  "name": "signbridge-isl-to-speech",
  "version": "2.2.0",
  "private": true,
  "description": "SignBridge ISL camera translator, Cloudflare Pages, Supabase and Android app",
  "scripts": {
    "serve": "npx http-server www -p 8000 -c-1",
    "deploy:cloudflare": "wrangler pages deploy www --project-name signbridge-isl-to-speech",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "wrangler": "^4.0.0",
    "http-server": "^14.1.1"
  }
}
